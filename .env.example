# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MySQL) - Shared with backend
DB_HOST=localhost
DB_PORT=3306
DB_NAME=astrotring_db
DB_USER=root
DB_PASSWORD=

# JWT Secrets & Expiry (Same secrets used by backend auth)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin for Admin Frontend
ADMIN_FRONTEND_URL=http://localhost:5174
